diff --git a/crates/core/src/bc/de.rs b/crates/core/src/bc/de.rs
index 1dd3f1d..c78db20 100644
--- a/crates/core/src/bc/de.rs
+++ b/crates/core/src/bc/de.rs
@@ -202,21 +202,30 @@ fn bc_modern_msg<'a>(
                         .unwrap_or("Not Text".to_string())
                 );
             }
-            let xml = BcXml::try_parse(processed_payload_buf.as_slice()).map_err(|e| {
-                error!("header.msg_id: {}", header.msg_id);
-                error!(
-                    "processed_payload_buf: {:X?}::{:?}",
-                    processed_payload_buf,
-                    std::str::from_utf8(&processed_payload_buf)
-                );
-                log::error!("e: {:?}", e);
-                Err::Error(make_error(
-                    buf,
-                    "Unable to parse Payload XML",
-                    ErrorKind::MapRes,
-                ))
-            })?;
-            payload = Some(BcPayloads::BcXml(xml));
+            payload = match BcXml::try_parse(processed_payload_buf.as_slice()) {
+                Ok(xml) => Some(BcPayloads::BcXml(xml)),
+                Err(e) => {
+                    // The whole message has been read (its length is in the header), so a
+                    // payload that is not readable XML does not desync the stream. Failing here
+                    // dropped the connection instead: the Argus MagiCam answers PushInfo (124)
+                    // with a payload that does not decrypt to XML, and the push registration,
+                    // retried after every reconnect, then cut every live view off. Deliver the
+                    // message without a payload; its response code still reaches the caller.
+                    warn!(
+                        "msg {} (num {}, code {}): payload is not readable XML, ignoring it: {:?}",
+                        header.msg_id,
+                        header.msg_num,
+                        header.response_code,
+                        e
+                    );
+                    debug!(
+                        "processed_payload_buf: {:X?}::{:?}",
+                        processed_payload_buf,
+                        std::str::from_utf8(&processed_payload_buf)
+                    );
+                    None
+                }
+            };
         }
     } else {
         payload = None;
